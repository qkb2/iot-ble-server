config BR2_PACKAGE_IOT_BLE_SERVER
    bool "iot_ble_server"
    help
    IoT BLE HTTP Server
    depends on BR2_TOOLCHAIN_HAS_THREADS
    select BR2_PACKAGE_LIBPTHREAD 

if BR2_PACKAGE_IOT_BLE_SERVER

config BR2_PACKAGE_IOT_BLE_SERVER_MAC
    string "BLE device MAC address"
    default "00:00:00:00:00:00"
    help
      BLE device MAC address to connect to (LE public or random).

config BR2_PACKAGE_IOT_BLE_SERVER_VERBOSE
    bool "Enable verbose logging"
    default n
    help
      Enable verbose debug output (ATT, GATT, reconnects, etc).

endif